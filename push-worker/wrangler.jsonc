{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "insight-desk-push",
  "main": "src/publication_gateway.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://kjkwon981229-prog.github.io",
    "VAPID_SUBJECT": "https://kjkwon981229-prog.github.io/insight-desk/"
  },
  "kv_namespaces": [
    {
      "binding": "PUSH_SUBSCRIPTIONS",
      "id": "60c00636319e45468b8c57677c8668fc"
    }
  ],
  "secrets": {
    "required": ["VAPID_PRIVATE_KEY", "PUSH_SEND_TOKEN"]
  },
  "triggers": {
    "crons": []
  }
}
